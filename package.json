{
  "name": "mirante-qr",
  "version": "1.0.2",
  "description": "Aplicativo desktop para geração de QR codes em lote.",
  "main": "./out/main/index.js",
  "author": "Backstage Mirante",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "assets": "node scripts/generate-assets.mjs",
    "build": "node scripts/clean-output.mjs && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "package:win": "npm run assets && npm run build && electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "package:store": "npm run assets && npm run build && electron-builder --config electron-builder.config.cjs --win --dir --publish never && node scripts/package-msix.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@oxlint/plugins": "1.78.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "electron-windows-msix": "^2.0.4",
    "jszip": "^3.10.1",
    "oxlint": "1.78.0",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
